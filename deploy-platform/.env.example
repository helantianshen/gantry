GANTRY_MYSQL_ROOT_PASSWORD=replace-with-a-root-password
GANTRY_MYSQL_DATABASE=gantry
GANTRY_MYSQL_USER=gantry
GANTRY_MYSQL_PASSWORD=replace-with-an-app-password
GANTRY_RABBITMQ_USER=gantry
GANTRY_RABBITMQ_PASSWORD=replace-with-a-rabbitmq-password

MYSQL_DSN=gantry:replace-with-an-app-password@tcp(127.0.0.1:13306)/gantry?parseTime=true
RABBITMQ_URL=amqp://gantry:replace-with-a-rabbitmq-password@127.0.0.1:5673/
REDIS_URL=redis://127.0.0.1:16379/0
